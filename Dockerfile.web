FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

COPY . .

ENV DATABASE_URL=postgresql://build-placeholder/placeholder
ENV NEXT_TELEMETRY_DISABLED=1

RUN npx prisma generate --schema=prisma/schema.prisma && npm run build

EXPOSE 3005

CMD ["npm", "run", "start"]
