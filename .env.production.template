# ─── Database (self-hosted PostgreSQL — Docker handles this) ─────────────────
# DATABASE_URL and DIRECT_URL are injected by docker-compose from POSTGRES_PASSWORD below.
# BRIDGE_DATABASE_URL is also local if you use the Matrix bridges.
POSTGRES_PASSWORD=choose_a_strong_password_here
BRIDGE_DATABASE_URL="postgresql://suby:choose_a_strong_password_here@postgres:5432/suby"

# ─── Redis (local — Docker handles this) ────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="YOUR_SECRET"
# Change these to your VPS domain/IP
AUTH_BASE_URL="http://YOUR_VPS_IP_OR_DOMAIN:4002"
AUTH_TRUSTED_ORIGINS="http://YOUR_VPS_IP_OR_DOMAIN:3005"
AUTH_ALLOW_SIGN_UP="true"
NEXT_PUBLIC_AUTH_ALLOW_SIGN_UP="true"
AUTH_ALLOWED_EMAILS="your@email.com"

FRONTEND_URL="http://YOUR_VPS_IP_OR_DOMAIN:3005"
NEXT_PUBLIC_API_URL="http://YOUR_VPS_IP_OR_DOMAIN:4002"

# ─── Google OAuth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ─── AI Keys ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY="YOUR_OPENAI_KEY"
GOOGLE_AI_API_KEY="YOUR_GOOGLE_AI_KEY"

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID="YOUR_SLACK_CLIENT_ID"
SLACK_CLIENT_SECRET="YOUR_SLACK_CLIENT_SECRET"
NEXT_PUBLIC_SLACK_CLIENT_ID="YOUR_SLACK_CLIENT_ID"
SLACK_SIGNING_SECRET="YOUR_SLACK_SIGNING_SECRET"
SLACK_APP_TOKEN="YOUR_SLACK_APP_TOKEN"

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# ─── X / Twitter ─────────────────────────────────────────────────────────────
X_CONSUMER_KEY="YOUR_X_KEY"
X_CONSUMER_SECRET="YOUR_X_SECRET"
TWITTER_AS_TOKEN="YOUR_TWITTER_AS_TOKEN"
TWITTER_HS_TOKEN="YOUR_TWITTER_HS_TOKEN"

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
TELEGRAM_API_ID="YOUR_API_ID"
TELEGRAM_API_HASH="YOUR_API_HASH"

# ─── LinkedIn ────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"
LINKEDIN_AS_TOKEN="YOUR_LINKEDIN_AS_TOKEN"
LINKEDIN_HS_TOKEN="YOUR_LINKEDIN_HS_TOKEN"

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_USER="your@email.com"
EMAIL_PASS="YOUR_APP_PASSWORD"

# ─── Misc ────────────────────────────────────────────────────────────────────
SERPAPI_KEY="YOUR_SERPAPI_KEY"
ENCRYPTION_KEY="YOUR_ENCRYPTION_KEY"
MATRIX_AS_TOKEN="YOUR_MATRIX_AS_TOKEN"
MATRIX_BRIDGE_OWNER_USER_ID="YOUR_MATRIX_USER_ID"
