{
  "name": "suby-contacts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "dotenv -e .env.local -- tsx watch src/server/index.ts",
    "build": "prisma db push --accept-data-loss && prisma generate && next build",
    "start": "next start -p 3005",
    "start:api": "dotenv -e .env.local -- tsx src/server/index.ts",
    "start:railway": "tsx src/server/index.ts",
    "db:push": "dotenv -e .env.local -- prisma db push --schema=prisma/schema.prisma",
    "db:generate": "dotenv -e .env.local -- prisma generate --schema=prisma/schema.prisma",
    "db:seed:demo": "dotenv -e .env.local -- tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@better-auth/prisma-adapter": "^1.6.11",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^6.17.16",
    "better-auth": "^1.6.11",
    "better-sqlite3": "^12.10.0",
    "bullmq": "^5.77.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "discord.js": "^14.26.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "googleapis": "^172.0.0",
    "ioredis": "^5.11.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.3",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.10",
    "openai": "^6.39.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "telegram": "^2.26.22",
    "twitter-api-v2": "^1.29.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
